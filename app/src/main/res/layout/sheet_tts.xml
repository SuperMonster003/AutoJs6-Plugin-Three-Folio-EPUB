<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_read_aloud_settings"
            android:textAppearance="?attr/textAppearanceHeadline6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.Reader.PreferenceLabel"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:text="@string/text_read_aloud_speed" />

            <TextView
                android:id="@+id/speed_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceSubtitle2" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/speed_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="10"
            android:valueFrom="50"
            android:valueTo="300" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.Reader.PreferenceLabel"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:text="@string/text_read_aloud_pitch" />

            <TextView
                android:id="@+id/pitch_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceSubtitle2" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/pitch_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="10"
            android:valueFrom="50"
            android:valueTo="200" />

        <TextView
            style="@style/Widget.Reader.PreferenceLabel"
            android:text="@string/text_read_aloud_language" />

        <Spinner
            android:id="@+id/language"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            style="@style/Widget.Reader.PreferenceLabel"
            android:text="@string/text_read_aloud_voice" />

        <Spinner
            android:id="@+id/voice"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.Reader.PreferenceLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/text_read_aloud_sleep_timer" />

            <TextView
                android:id="@+id/sleep_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:textAppearance="?attr/textAppearanceSubtitle2" />
        </LinearLayout>

        <Spinner
            android:id="@+id/sleep_timer"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/keep_screen_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/text_read_aloud_keep_screen_on"
            android:textAppearance="?attr/textAppearanceSubtitle2" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/text_read_aloud_background"
            android:textAppearance="?attr/textAppearanceSubtitle2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_read_aloud_background_hint"
            android:textAppearance="?attr/textAppearanceCaption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/system_settings"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/text_read_aloud_open_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/install_voice"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/text_read_aloud_install_voice" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
