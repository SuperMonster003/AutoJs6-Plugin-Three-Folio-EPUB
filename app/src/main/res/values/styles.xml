<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Plugin.ConfirmDialog</item>
        <item name="actionOverflowButtonStyle">@style/Widget.PluginOverflowButton</item>
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary_dark</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="android:colorAccent">@color/color_secondary</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="windowActionModeOverlay">true</item>
    </style>

    <style name="AppTheme.Toolbar" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <!-- The overflow menus are themed on top of AppTheme.Toolbar, whose primary text is white, so the overlay sets the
         text again; with the empty Material 3 overlay the light menus showed white text on their light container.
         The Material 3 menu paints colorSurfaceContainer: the menus use the neutral surfaces of AppThemePalette (the
         white app bar here, the gray bottom control surface at night in values-night) instead of the tinted Material 3
         defaults. The Material 3 overlays also reset colorPrimary to the default purple, so the checked boxes and radio
         buttons of the reader menu get the plugin's teal back (with its check mark color), one that stays readable on
         the night surface. -->
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3.Light">
        <item name="android:textColorPrimary">@color/popup_menu_text</item>
        <item name="colorSurface">@color/popup_menu_surface</item>
        <item name="colorSurfaceContainer">@color/popup_menu_surface</item>
        <item name="colorPrimary">@color/popup_menu_accent</item>
        <item name="colorOnPrimary">@color/popup_menu_on_accent</item>
    </style>

    <style name="AppTheme.ReaderDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog" />

    <style name="Widget.Reader.PreferenceLabel" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceSubtitle2</item>
    </style>

    <style name="Widget.Reader.ToggleButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Widget.PluginOverflowButton" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="SettingsToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
    </style>
</resources>
