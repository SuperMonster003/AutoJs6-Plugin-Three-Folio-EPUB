<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="actionOverflowButtonStyle">@style/Widget.PluginOverflowButton</item>
        <item name="materialAlertDialogTheme">@style/AppTheme.ReaderDialog</item>
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary_dark</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="android:colorAccent">@color/color_secondary</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="windowActionModeOverlay">true</item>
    </style>

    <style name="AppTheme.Toolbar" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light" />

    <style name="AppTheme.ReaderDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/dialog_foreground</item>
        <item name="colorSecondary">@color/dialog_foreground</item>
        <item name="colorAccent">@color/dialog_foreground</item>
        <item name="android:colorAccent">@color/dialog_foreground</item>
        <item name="colorControlActivated">@color/dialog_foreground</item>
        <item name="colorControlNormal">@color/dialog_foreground</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Reader.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Reader.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Reader.DialogButton</item>
    </style>

    <style name="Widget.Reader.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/dialog_foreground</item>
    </style>

    <style name="Widget.Reader.PreferenceLabel" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceSubtitle2</item>
    </style>

    <style name="Widget.Reader.ToggleButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Widget.PluginOverflowButton" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

</resources>
