<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET: remote resources referenced by a book (roadmap D6) and the manual update check (D28). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="org.autojs.permission.PLUGIN" />
    <!-- Read-aloud (roadmap P3 / D15): speech runs inside a mediaPlayback foreground service so it
         survives the screen turning off; these three permissions exist for that alone (exemption recorded
         in AGENTS.md section 6). POST_NOTIFICATIONS is requested at runtime, once, when read-aloud
         starts on Android 13+; refusing it keeps read-aloud working without the notification controls. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- media3-exoplayer (a transitive dependency of readium-navigator-media-tts) declares these two
         permissions in its own manifest. The plugin never plays media through ExoPlayer (R8 strips the
         library entirely), so they are removed (roadmap D19). The read-aloud service (P3) needs neither:
         the system text-to-speech engine produces the audio in its own process. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WAKE_LOCK"
        tools:node="remove" />

    <queries>
        <package android:name="org.autojs.autojs6" />
        <!-- Read-aloud (roadmap P3): TextToSpeech discovers engines through this action on Android 11+,
             and the voice-data installer is resolved before it is started. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.tts.engine.INSTALL_TTS_DATA" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic is true on purpose (roadmap D31): books may reference http:// resources
         and the maintainer chose to keep Readium's default behavior. The update check uses HTTPS only. -->
    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="org.autojs.plugin.contract.NATIVE_PAGE_ALIGNMENT"
            android:value="0" />

        <meta-data
            android:name="org.autojs.plugin.WAKE_ACTIVITY"
            android:value=".WakeActivity" />

        <meta-data
            android:name="org.autojs.plugin.info.AUTHOR"
            android:value="@string/plugin_author" />

        <activity
            android:name=".WakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.action.WAKE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Standalone entry (roadmap P4.1): the launcher icon opens the recent-books grid; it is
             exported without a permission because it is the app's own front door and takes no data. -->
        <activity
            android:name=".launcher.LauncherActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Roadmap P4.3: the settings page and the release history are reached from the launcher menu and the
             reader overflow only; neither takes data, neither is exported. -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".settings.ReleaseHistoryActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <!-- The ACTION_VIEW door (roadmap P4.2 / D27): other apps hand over content:// EPUB documents here.
             Exported without a permission; the content scheme and the EPUB type only, no octet-stream or
             path-pattern fallback. The request rules of this door live in EpubRequestPolicy. -->
        <activity
            android:name=".ExternalViewerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:mimeType="application/epub+zip"
                    android:scheme="content" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EpubReaderActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="org.autojs.plugin.EXPLORER_ACTION_EXECUTE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".PluginInfoService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <service
            android:name=".ExplorerActionService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <intent-filter>
                <action android:name="org.autojs.plugin.EXPLORER_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- The EPUB capability service (roadmap P5.2 / D10): the host's IEpubPlugin door, sharing the package
             identity of the Explorer Action service with engine `epub`. Exported behind the plugin permission
             and discovered by action + category, like the host's other capability services; CallerGuard
             additionally limits callers to the AutoJs6 host package. -->
        <service
            android:name=".service.ReadiumEpubReaderPluginService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <intent-filter>
                <action android:name="org.autojs.plugin.EPUB" />
                <category android:name="epub" />
            </intent-filter>
        </service>

        <!-- Read-aloud (roadmap P3 / D15): not exported, only the reader binds it; the media3 action lets the
             library connect its own notification controller in-process. Exists only while a voice reads. -->
        <service
            android:name=".tts.TtsForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

    </application>

</manifest>
